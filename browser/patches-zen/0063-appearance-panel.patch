+/* ==========================================================================
+   The Appearance panel (patch 0063). Opened from the pinned Appearance row,
+   anchored to the same button as the menu.
+
+   Every colour below is a --kavacha-* token with a literal Midnight fallback,
+   which is this file's existing convention and, more to the point, the reason
+   this panel can show you a light theme without going white-on-white. Hardcoded
+   hex is what patch 0061 spent its time removing; do not add any here.
+   ========================================================================== */
+
+#kavacha-appearance-panel {
+  --panel-background: var(--kavacha-surface-elevated, #16131f);
+  --panel-border-color: var(--kavacha-border, #322b4a);
+  --panel-color: var(--kavacha-text-primary, #f6f4fc);
+  /* Wide enough for three theme cards on one row and the ten accent swatches
+     on another, which is what decides this number -- narrower and the palette
+     wraps into something that no longer reads as a palette. */
+  min-width: 360px;
+  max-width: 360px;
+  padding: 10px;
+}
+
+.kavacha-appearance-body {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  /* The panel measures the space below its anchor and sets this property on
+     open (see KavachaAppearancePanel.open). The calc() fallback is only for a
+     panel shown some other way, and is deliberately conservative: `100vh`
+     inside a XUL popup is the POPUP's viewport, measured at 808px in a 758px
+     window, so a vh-based cap over-estimates the room available. */
+  max-height: var(--kavacha-appearance-max, calc(100vh - 14rem));
+  overflow-y: auto;
+  overflow-x: hidden;
+}
+
+.kavacha-appearance-heading {
+  margin-block: 10px 2px;
+  font-size: 11px;
+  font-weight: 600;
+  text-transform: uppercase;
+  letter-spacing: 0.04em;
+  color: var(--kavacha-text-secondary, #cabfe6);
+}
+
+/* --- Segmented controls (mode, tabs, density, sidebar) ------------------- */
+.kavacha-appearance-row {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding-block: 3px;
+}
+
+.kavacha-appearance-row-label {
+  flex: 0 0 62px;
+  font-size: 12px;
+  color: var(--kavacha-text-secondary, #cabfe6);
+}
+
+.kavacha-appearance-segments {
+  display: flex;
+  flex: 1;
+  padding: 2px;
+  border-radius: 8px;
+  background: var(--kavacha-surface-sunken, #060409);
+}
+
+.kavacha-appearance-segment {
+  flex: 1;
+  padding: 5px 6px;
+  appearance: none;
+  border: none;
+  border-radius: 6px;
+  background: transparent;
+  color: var(--kavacha-text-secondary, #cabfe6);
+  font: inherit;
+  font-size: 12px;
+  cursor: pointer;
+}
+
+.kavacha-appearance-segment:hover {
+  background: var(
+    --kavacha-tab-hover-background,
+    color-mix(in srgb, currentColor 10%, transparent)
+  );
+}
+
+/* aria-pressed is both the accessible state and the selected style, so the
+   two cannot drift apart. */
+.kavacha-appearance-segment[aria-pressed="true"] {
+  background: var(--kavacha-tab-active-background, #241d3a);
+  color: var(--kavacha-text-primary, #f6f4fc);
+}
+
+.kavacha-appearance-segment:focus-visible {
+  outline: 2px solid var(--kavacha-accent, var(--kavacha-accent-fallback));
+  outline-offset: -2px;
+}
+
+.kavacha-appearance-mode {
+  margin-block-end: 2px;
+}
+
+/* --- Theme cards: the palette ------------------------------------------- */
+.kavacha-appearance-themes {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
+  gap: 8px;
+}
+
+.kavacha-appearance-card {
+  display: flex;
+  flex-direction: column;
+  gap: 5px;
+  padding: 6px;
+  appearance: none;
+  border: 1px solid var(--kavacha-border, #322b4a);
+  border-radius: 10px;
+  background: var(--kavacha-surface, #0b0912);
+  color: var(--kavacha-text-primary, #f6f4fc);
+  font: inherit;
+  text-align: start;
+  cursor: pointer;
+}
+
+.kavacha-appearance-card:hover {
+  border-color: var(--kavacha-accent, var(--kavacha-accent-fallback));
+}
+
+.kavacha-appearance-card[aria-pressed="true"] {
+  border-color: var(--kavacha-accent, var(--kavacha-accent-fallback));
+  box-shadow: inset 0 0 0 1px
+    var(--kavacha-accent, var(--kavacha-accent-fallback));
+}
+
+.kavacha-appearance-card:focus-visible {
+  outline: 2px solid var(--kavacha-accent, var(--kavacha-accent-fallback));
+  outline-offset: 1px;
+}
+
+/* Five bands of the theme's own colours. The bands are painted from inline
+   styles set by the panel, not from tokens here: they must show the colours of
+   the theme on the card, not the colours of the theme you are wearing. */
+.kavacha-appearance-swatch {
+  display: flex;
+  height: 26px;
+  border-radius: 6px;
+  overflow: hidden;
+  /* A theme whose surface matches the card's would otherwise have no edge. */
+  border: 1px solid var(--kavacha-border, #322b4a);
+}
+
+.kavacha-appearance-band {
+  flex: 1;
+}
+
+.kavacha-appearance-card-name {
+  font-size: 12px;
+  line-height: 1.2;
+}
+
+/* Shown when the engine's WCAG check says this theme's text cannot be read on
+   its own surface. The engine repairs it on apply; this says so beforehand. */
+.kavacha-appearance-warn {
+  font-size: 10px;
+  color: var(--kavacha-warning, #e8a33d);
+}
+
+/* --- Accent palette ------------------------------------------------------ */
+.kavacha-appearance-accents {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 7px;
+  padding-block: 2px;
+}
+
+.kavacha-appearance-accent {
+  width: 24px;
+  height: 24px;
+  padding: 0;
+  appearance: none;
+  border: 1px solid var(--kavacha-border, #322b4a);
+  border-radius: 50%;
+  cursor: pointer;
+}
+
+.kavacha-appearance-accent[aria-pressed="true"] {
+  outline: 2px solid var(--kavacha-text-primary, #f6f4fc);
+  outline-offset: 2px;
+}
+
+.kavacha-appearance-accent:focus-visible {
+  outline: 2px solid var(--kavacha-accent, var(--kavacha-accent-fallback));
+  outline-offset: 2px;
+}
+
+/* "Use the system accent" paints itself with the system colour, so the button
+   is a preview of what choosing it does. */
+.kavacha-appearance-accent-system {
+  background: AccentColor;
+}
+
+.kavacha-appearance-accent-custom {
+  background: var(--kavacha-surface-sunken, #060409);
+  /* Strip the native colour input's chrome so it sits in the row as one more
+     swatch rather than as a button with a swatch inside it. */
+  padding: 2px;
+  inline-size: 24px;
+  block-size: 24px;
+}
+
+.kavacha-appearance-layout {
+  margin-block-start: 10px;
+}
+
+.kavacha-appearance-footer {
+  margin-block-start: 10px;
+  padding-block-start: 6px;
+  border-block-start: 1px solid var(--kavacha-border, #322b4a);
+}
+
