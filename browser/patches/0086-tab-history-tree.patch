+  // ==========================================================================
+  // Kavacha (patch 0086): the saved-session manager (FEATURES 7.2).
+  //
+  // Patch 0081 shipped "Save This Research Session" and stopped there: a
+  // saved session could only be found through the timeline of the ONE Space
+  // it belonged to, which is exactly the thing a person forgets three weeks
+  // later. This lists every saved session across every Space, and adds the
+  // two operations a keeper needs and 0081 had no place for — rename, and
+  // delete. Delete matters more than it looks: retention deliberately exempts
+  // labelled snapshots, so without this a saved session is permanent.
+  //
+  // Restore goes through kavachaBranchSpace, so it stays NON-DESTRUCTIVE
+  // (ADR 0006's decision): restoring a session never overwrites the present,
+  // it forks a branch. One mechanism, not two.
+  async kavachaOpenSavedSessions() {
+    if (this.privateWindowOrDisabled) {
+      return;
+    }
+    const { KavachaSpaceHistory } = ChromeUtils.importESModule(
+      "resource:///modules/KavachaSpaceHistory.sys.mjs"
+    );
+    const sessions = await KavachaSpaceHistory.listSavedSessions();
+
+    const panel = document.getElementById("kavacha-sessions-panel");
+    document.getElementById("kavacha-sessions-empty").hidden = !!sessions.length;
+
+    const list = document.getElementById("kavacha-sessions-list");
+    list.textContent = "";
+    const fmt = new Intl.DateTimeFormat(undefined, {
+      dateStyle: "medium",
+      timeStyle: "short",
+    });
+    const [restoreLabel, renameLabel, deleteLabel, renamePrompt] =
+      await document.l10n.formatValues([
+        { id: "kavacha-timeline-restore" },
+        { id: "kavacha-sessions-rename" },
+        { id: "kavacha-sessions-delete" },
+        { id: "kavacha-sessions-rename-prompt" },
+      ]);
+
+    for (const session of sessions) {
+      const space = this.getWorkspaceFromId(session.spaceUuid);
+      const row = document.createXULElement("hbox");
+      row.setAttribute("align", "center");
+      row.style.gap = "6px";
+
+      const label = document.createXULElement("label");
+      label.setAttribute("flex", "1");
+      label.setAttribute("crop", "end");
+      label.value = `${session.label} · ${space?.name || "—"} · ${session.tabCount} tabs · ${fmt.format(new Date(session.createdAt))}`;
+      row.append(label);
+
+      const restore = document.createXULElement("button");
+      restore.setAttribute("label", restoreLabel);
+      restore.addEventListener("command", () => {
+        panel.hidePopup();
+        this.kavachaBranchSpace(session.id).catch(e =>
+          console.error("kavachaOpenSavedSessions: restore failed", e)
+        );
+      });
+
+      const rename = document.createXULElement("button");
+      rename.setAttribute("label", renameLabel);
+      rename.addEventListener("command", async () => {
+        const value = { value: session.label };
+        const ok = Services.prompt.prompt(
+          window,
+          "Kavacha",
+          renamePrompt,
+          value,
+          null,
+          {}
+        );
+        if (ok && value.value.trim()) {
+          await KavachaSpaceHistory.renameSnapshot(session.id, value.value);
+          this.kavachaOpenSavedSessions();
+        }
+      });
+
+      const remove = document.createXULElement("button");
+      remove.setAttribute("label", deleteLabel);
+      remove.addEventListener("command", async () => {
+        // Confirmed, because retention exempts saved sessions: this is the
+        // only way one goes away, so it must not be a stray click.
+        const ok = Services.prompt.confirm(
+          window,
+          "Kavacha",
+          `Delete the saved session "${session.label}"?`
+        );
+        if (ok) {
+          await KavachaSpaceHistory.deleteSnapshot(session.id);
+          this.kavachaOpenSavedSessions();
+        }
+      });
+
+      row.append(restore, rename, remove);
+      list.append(row);
+    }
+
+    const anchor = this.workspaceIcons || gURLBar.textbox;
+    panel.openPopup(anchor, "after_start", 0, 0, false, false);
+  }
+
