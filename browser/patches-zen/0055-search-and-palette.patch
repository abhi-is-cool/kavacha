+      const domain = result.payload?.zenDomain;
+      if (domain && domain !== lastDomain) {
+        result.payload.groupHeader = result.payload.group || "";
+      } else if (result.payload) {
+        // A result object can be reused across queries; a stale header would
+        // print a section title in the middle of a run.
