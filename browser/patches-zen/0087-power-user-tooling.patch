diff --git a/src/zen/kavacha-write/write.css b/src/zen/kavacha-write/write.css
new file mode 100644
index 0000000..b9ccc75
--- /dev/null
+++ b/src/zen/kavacha-write/write.css
@@ -0,0 +1,101 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* about:write — writing mode. The whole design brief is "nothing else on
+ * screen": one measure-width column, a bar that stays quiet, and no borders
+ * around the thing being written. Same token vocabulary and fallbacks as the
+ * other Kavacha content pages. */
+
+:root {
+  --kwr-accent: var(
+    --zen-primary-color,
+    var(--kavacha-accent, var(--kavacha-accent-fallback, #8b7bd8))
+  );
+}
+
+body {
+  margin: 0;
+  height: 100vh;
+  display: flex;
+  flex-direction: column;
+  font: message-box;
+  color: var(--kavacha-text, #e8e6f0);
+  background: var(--kavacha-surface, #14111f);
+}
+
+.kwr-bar {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  padding: 10px 18px;
+  font-size: 12px;
+  opacity: 0.65;
+}
+
+.kwr-bar:hover {
+  opacity: 1;
+}
+
+.kwr-spacer {
+  flex: 1;
+}
+
+.kwr-target {
+  font-weight: 600;
+  overflow-wrap: anywhere;
+}
+
+.kwr-link {
+  padding: 0;
+  border: none;
+  background: none;
+  color: var(--kwr-accent);
+  font: inherit;
+  cursor: pointer;
+}
+
+.kwr-link:hover {
+  text-decoration: underline;
+}
+
+.kwr-stage {
+  flex: 1;
+  display: flex;
+  justify-content: center;
+  overflow: auto;
+  padding: 0 18px 40px;
+}
+
+.kwr-input,
+.kwr-rendered {
+  width: min(70ch, 100%);
+  font-size: 17px;
+  line-height: 1.7;
+}
+
+.kwr-input {
+  border: none;
+  outline: none;
+  resize: none;
+  background: transparent;
+  color: inherit;
+  font-family: inherit;
+  padding: 8px 0 120px;
+}
+
+.kwr-rendered {
+  padding-bottom: 120px;
+  overflow-wrap: anywhere;
+}
+
+.kwr-rendered :is(h1, h2, h3) {
+  line-height: 1.3;
+}
+
+.kwr-rendered blockquote {
+  margin-inline: 0;
+  padding-inline-start: 14px;
+  border-inline-start: 3px solid var(--kwr-accent);
+  opacity: 0.9;
+}
