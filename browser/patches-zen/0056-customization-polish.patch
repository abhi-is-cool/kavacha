-.css-editor {
+/* --- CSS editor + syntax highlighting (patch 0056) ------------------------
+   The textarea is the real editing surface and stays on top, transparent; the
+   <pre> behind it paints the colours. EVERY typography and box property below
+   is shared between the two -- font, size, line-height, tab-size, padding,
+   border width, white-space -- because any difference between them shows up
+   directly as text drifting out from under the caret. */
+.css-editor-wrap {
+  position: relative;
+  margin-top: 4px;
+  min-height: 260px;
+  display: grid;
+}
+
+.css-editor,
+.css-highlight {
+  grid-area: 1 / 1;
   width: 100%;
   min-height: 260px;
-  margin-top: 4px;
+  margin: 0;
   padding: 14px 16px;
   border-radius: 10px;
-  border: 1px solid var(--studio-border);
-  background: var(--studio-sunken);
-  color: var(--studio-text);
+  border: 1px solid transparent;
   font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
   font-size: 13px;
   line-height: 1.55;
-  resize: vertical;
   tab-size: 2;
   white-space: pre;
+  overflow: auto;
+  box-sizing: border-box;
+}
+
+.css-editor {
+  position: relative;
+  z-index: 1;
+  border-color: var(--studio-border);
+  background: transparent;
+  /* The text itself is painted by the layer underneath; only the caret and
+     the selection come from the textarea. */
+  color: transparent;
+  caret-color: var(--studio-text);
+  resize: vertical;
+}
+
+.css-editor::selection {
+  /* A transparent-text selection would be invisible, so tint the box. */
+  background: color-mix(in srgb, var(--studio-accent) 35%, transparent);
+}
+
+.css-editor::placeholder {
+  color: var(--studio-text-dim);
+}
+
+.css-highlight {
+  background: var(--studio-sunken);
+  color: var(--studio-text);
+  /* Never intercept a click: the textarea above owns all interaction. */
+  pointer-events: none;
+  /* Scrolled programmatically in lockstep with the textarea. */
+  overflow: hidden;
 }
 
+.css-highlight code {
+  font: inherit;
+  white-space: inherit;
+}
+
 .css-editor:focus {
   outline: 2px solid var(--studio-accent);
   outline-offset: -1px;
 }
 
+/* Token colours. Chosen for contrast against --studio-sunken rather than for
+   resemblance to any particular editor theme. */
+.css-highlight .tok-comment {
+  color: var(--studio-text-dim);
+  font-style: italic;
+}
+
+.css-highlight .tok-selector {
+  color: var(--studio-text);
+  font-weight: 600;
+}
+
+.css-highlight .tok-property {
+  color: #7fb6ff;
+}
+
+.css-highlight .tok-value {
+  color: #9be3a8;
+}
+
+.css-highlight .tok-string {
+  color: #e8c07d;
+}
+
+.css-highlight .tok-number,
+.css-highlight .tok-color {
+  color: #e8a33d;
+}
+
+.css-highlight .tok-atrule {
+  color: #c792ea;
+  font-weight: 600;
+}
+
+.css-highlight .tok-important {
+  color: #e06c75;
+  font-weight: 600;
+}
+
+.css-highlight .tok-punct {
+  color: var(--studio-text-dim);
+}
