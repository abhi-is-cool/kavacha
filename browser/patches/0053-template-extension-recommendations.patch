 kavacha-notes-preview-empty = Nothing to preview yet.
+
+# Kavacha patch 0053 — recommended extensions for a template Space.
+kavacha-recommendations-title =
+    .value = Recommended for { $name }
+kavacha-recommendations-intro = Suggestions that fit this template. Nothing is installed for you — each opens its listing so you can read the permissions first.
+# Read with formatValues and applied with setAttribute("label", ...), so these
+# are value-only messages, not .label attribute messages.
+kavacha-recommendations-get = Get extension
+kavacha-recommendations-installed = Already installed
+kavacha-recommendations-limit =
+    .label = Run only these in this Space
+kavacha-recommendations-note = You can change which extensions run in a Space at any time from the Space menu → Workspace Extensions.
