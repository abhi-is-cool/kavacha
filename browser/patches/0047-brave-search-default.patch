+def matches_identifier(entry, rid):
+  """True if entry's identifier is rid, or matches a trailing-* prefix."""
+  identifier = entry.get('identifier', '')
+  return identifier == rid or (rid.endswith('*') and identifier.startswith(rid[:-1]))
+
+
 def merge_dumps(original, updates):
-  """Filters entries from the original dump, removing those whose identifiers are specified in the updates removal list."""
+  """Applies an overrides file to a Remote Settings dump.
+
+  Three operations, applied in this order:
+
+    remove.identifiers  Drop records by identifier ('foo', or 'foo-*' for a
+                        prefix). Upstream Zen's original behaviour.
+    add.records         Append whole records. A record already present under
+                        the same identifier is replaced, so this doubles as a
+                        full override and stays idempotent across re-runs.
+    patch               Surgical top-level field overrides on records already
+                        in the dump, matched by identifier and/or recordType.
+                        Only the fields named in 'set' change, so everything
+                        else keeps tracking upstream -- the right tool when we
+                        want to alter one aspect of a Mozilla-maintained
+                        record (an engine's availability, the global default)
+                        without also freezing its URLs.
+
+  Kavacha added add/patch to ship Brave Search as the default with a bundled
+  set of privacy alternatives: upstream carries neither Brave nor Kagi, and
+  gates Startpage behind an experiment.
+  """
   remove_ids = updates.get('remove', {"identifiers": []}).get('identifiers', [])
 
   # Filter out entries in original that are in remove_ids.
@@ -29,6 +55,31 @@
       )
   ]
 
+  for record in updates.get('add', {}).get('records', []):
+    identifier = record.get('identifier')
+    if identifier:
+      merged_data = [e for e in merged_data if e.get('identifier') != identifier]
+    merged_data.append(record)
+
+  for rule in updates.get('patch', []):
+    if 'identifier' not in rule and 'recordType' not in rule:
+      exit(f"Patch rule must match on identifier and/or recordType: {rule}")
+    matched = 0
+    for entry in merged_data:
+      if 'identifier' in rule and not matches_identifier(entry, rule['identifier']):
+        continue
+      if 'recordType' in rule and entry.get('recordType') != rule['recordType']:
+        continue
+      entry.update(rule.get('set', {}))
+      matched += 1
+    if not matched:
+      # A rule matching nothing means upstream moved and our intent silently
+      # stopped applying. For the search config that ships a build whose
+      # default engine is quietly Google again -- fail the build instead,
+      # because otherwise the symptom is invisible until someone opens the
+      # browser and types a query.
+      exit(f"No record matched patch rule: {rule}")
+
