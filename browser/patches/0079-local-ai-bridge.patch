+// "Summarize This Page" (ADR 0013): send the current page's captured text to
+// the local AI bridge and show the summary in the AI panel. Uses the personal
+// index's stored text (ADR 0012) so nothing new has to be extracted; if the
+// page was not indexed (index off, or opened seconds ago) it says so. All
+// model contact is at the user's local endpoint — the bridge never goes
+// remote. Fails soft: no runtime -> a plain "no local model" message, not an
+// error.
+const kSummarizeSystem =
+  "You are a concise assistant. Summarize the following web page in 4-6 " +
+  "short bullet points, then one sentence on why it might matter. Use only " +
+  "the text provided.";
+
+async function summarizeActivePage(window) {
+  const doc = window.document;
+  const panel = doc.getElementById("kavacha-ai-panel");
+  const body = doc.getElementById("kavacha-ai-body");
+  const title = doc.getElementById("kavacha-ai-title");
+  if (!panel || !body) {
+    return;
+  }
+  const t = async (id, fb) => {
+    try {
+      return (await doc.l10n.formatValue(id)) || fb;
+    } catch (e) {
+      return fb;
+    }
+  };
+  title.textContent = await t("kavacha-ai-summary-title", "Page summary");
+  body.textContent = await t("kavacha-ai-thinking", "Thinking…");
+  const anchor =
+    doc.getElementById("kavacha-menu-button") ||
+    doc.getElementById("PanelUI-menu-button") ||
+    window.gBrowser.selectedTab;
+  try {
+    panel.openPopup(anchor, "bottomright topright", 0, 0, false, false);
+  } catch (e) {
+    panel.openPopupAtScreen(200, 120, false);
+  }
+
+  try {
+    const { KavachaAIBridge } = ChromeUtils.importESModule(
+      "resource:///modules/KavachaAIBridge.sys.mjs"
+    );
+    const { KavachaPersonalIndex } = ChromeUtils.importESModule(
+      "resource:///modules/KavachaPersonalIndex.sys.mjs"
+    );
+    const status = await KavachaAIBridge.isAvailable();
+    if (!status.available) {
+      body.textContent = await t(
+        "kavacha-ai-unavailable",
+        "No local model found. Install a local model runtime (for example " +
+          "Ollama) and check Settings → Privacy → Local AI."
+      );
+      return;
+    }
+    const url = window.gBrowser.selectedBrowser?.currentURI?.spec || "";
+    const text = await KavachaPersonalIndex.getText(url);
+    if (!text) {
+      body.textContent = await t(
+        "kavacha-ai-not-indexed",
+        "This page has not been indexed yet, so there is no text to " +
+          "summarize. Give it a moment, or check that the personal index is on."
+      );
+      return;
+    }
+    const summary = await KavachaAIBridge.generate(text, {
+      system: kSummarizeSystem,
+    });
+    body.textContent =
+      summary || (await t("kavacha-ai-empty", "The model returned nothing."));
+  } catch (e) {
+    console.error("KavachaCommandRegistry: summarize failed", e);
+    body.textContent = await t(
+      "kavacha-ai-error",
+      "The local model could not complete the request."
+    );
+  }
+}
+
