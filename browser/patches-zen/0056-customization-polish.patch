+const kLightSurfaceThreshold = 0.45;
+
+function themeMode(colors) {
+  const rgb = parseCssColor(colors?.surface || "");
+  if (!rgb) {
+    return "dark";
+  }
+  const luminance =
+    (0.2126 * rgb[0] + 0.7152 * rgb[1] + 0.0722 * rgb[2]) / 255;
+  return luminance < kLightSurfaceThreshold ? "dark" : "light";
