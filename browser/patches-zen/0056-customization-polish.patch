+/* ==========================================================================
+   Active-tab emphasis and tab-strip spacing (patch 0056).
+
+   The open item was "active-tab emphasis and tab-strip spacing polish". The
+   concrete problem: at Kavacha's shipped horizontal density the selected tab
+   was distinguished only by a slightly different background, which against
+   the Midnight surface is a few percent of luminance -- on a laptop panel at
+   an angle it is genuinely hard to tell which tab you are on. Emphasis is
+   added on THREE independent channels so it survives any one of them being
+   washed out: surface, a weight bump on the label, and an accent rail.
+
+   The rail is drawn with an inset box-shadow rather than a border so it costs
+   no layout and cannot shift the strip when selection moves.
+   ========================================================================== */
+
+#tabbrowser-tabs .tabbrowser-tab[selected] > .tab-stack > .tab-background {
+  box-shadow: inset 0 -2px 0 0
+    var(--zen-primary-color, var(--kavacha-accent, var(--kavacha-accent-fallback)));
+}
+
+/* In vertical mode the strip runs down the side, so the rail belongs on the
+   leading edge instead of underneath. */
+/* stylelint-disable-next-line media-query-no-invalid */
+@media -moz-pref("zen.tabs.vertical") {
+  #tabbrowser-tabs .tabbrowser-tab[selected] > .tab-stack > .tab-background {
+    box-shadow: inset 2px 0 0 0
+      var(--zen-primary-color, var(--kavacha-accent, var(--kavacha-accent-fallback)));
+  }
+}
+
+#tabbrowser-tabs .tabbrowser-tab[selected] .tab-label {
+  font-weight: 600;
+}
+
+/* Unselected tabs step back so the selected one steps forward; done with
+   opacity on the label rather than a colour so it follows any theme. */
+#tabbrowser-tabs .tabbrowser-tab:not([selected]) .tab-label {
+  opacity: 0.72;
+}
+
+#tabbrowser-tabs .tabbrowser-tab:not([selected]):hover .tab-label {
+  opacity: 1;
+}
+
+/* Spacing: tabs were flush against each other, which reads as one long bar
+   rather than as separate tabs. A small gap plus a rounded background makes
+   the boundaries legible without changing tab width enough to fit fewer. */
+#tabbrowser-tabs .tabbrowser-tab {
+  margin-inline: 1px;
+}
+
+#tabbrowser-tabs .tabbrowser-tab > .tab-stack > .tab-background {
+  border-radius: 8px;
+}
diff --git a/src/zen/common/styles/kavacha-theme-light.inc.css b/src/zen/common/styles/kavacha-theme-light.inc.css
new file mode 100644
--- /dev/null
+++ b/src/zen/common/styles/kavacha-theme-light.inc.css
@@ -0,0 +1,94 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* ==========================================================================
+   Kavacha light themes — the light half of the 0016 bridge (patch 0056).
+
+   Patch 0016 wired Kavacha's tokens into Zen with
+   `--zen-branding-dark: var(--kavacha-surface)` plus a column of
+   `light-dark(stock-light, var(--kavacha-*))`. Every one of those maps a
+   Kavacha token onto the DARK side only, which is exactly why ADR 0008
+   recorded "light themes are a follow-up": a bright surface produced
+   dark-derived chrome with light text sitting on it.
+
+   This file is the mirror image, and nothing more. It binds only when
+   KavachaThemeEngine has stamped kavacha-theme-mode="light" on the chrome
+   root, which the engine DERIVES from the active theme's own surface
+   luminance -- so at Kavacha's shipped dark default this whole layer is inert,
+   exactly as kavacha-layout.inc.css is at the default layout.
+
+   Ordering: %include'd AFTER kavacha-midnight.inc.css so these declarations
+   win at equal specificity, which is the same reason 0016 sits at the end of
+   zen-theme.css.
+   ========================================================================== */
+
+:root[kavacha-theme-mode="light"] {
+  /* The base every --zen-colors-* mix derives from. 0016 points the dark
+     branding colour at the surface; a light theme has to point the paper one
+     there instead, or every mix keeps deriving from Zen's stock #e2e2e2. */
+  --zen-branding-paper: var(--kavacha-surface);
+
+  /* Surfaces Zen defines directly rather than deriving. Mirrors the block in
+     kavacha-midnight.inc.css, light side. Both halves of each light-dark()
+     are filled: the pair must agree, because color-scheme is itself derived
+     from the surface and the two must not be able to disagree. */
+  --zen-main-browser-background: light-dark(
+    var(--kavacha-surface),
+    var(--kavacha-surface)
+  );
+  --zen-dialog-background: light-dark(
+    var(--kavacha-surface-elevated),
+    var(--kavacha-surface-elevated)
+  );
+  --zen-urlbar-background: light-dark(
+    color-mix(
+      in srgb,
+      var(--zen-primary-color) 3%,
+      var(--kavacha-surface-elevated) 97%
+    ),
+    color-mix(
+      in srgb,
+      var(--zen-primary-color) 4%,
+      var(--kavacha-surface-elevated) 96%
+    )
+  );
+  --zen-colors-border: light-dark(
+    color-mix(in srgb, var(--zen-colors-secondary) 50%, var(--kavacha-border)),
+    color-mix(in srgb, var(--zen-colors-secondary) 20%, var(--kavacha-border))
+  );
+
+  /* Zen's stock light values for these are tuned for near-white paper; a
+     tinted light surface needs them derived from the theme instead, or the
+     input and toolbar chrome float unattached above the background. */
+  --input-bgcolor: color-mix(
+    in srgb,
+    var(--kavacha-text-primary) 6%,
+    transparent
+  ) !important;
+  --toolbar-background-color: color-mix(
+    in srgb,
+    var(--kavacha-surface-elevated) 70%,
+    transparent
+  );
+  --zen-toolbar-element-bg: color-mix(
+    in srgb,
+    var(--kavacha-text-primary) 8%,
+    transparent
+  );
+  --zen-toolbar-element-bg-hover: color-mix(
+    in srgb,
+    var(--kavacha-text-primary) 12%,
+    transparent
+  );
+
+  /* These two carry hard-coded dark values that no color-scheme change
+     reaches, so the tab strip keeps a dark seam on an otherwise light
+     window until they are re-pointed at the theme. */
