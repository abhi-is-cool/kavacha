   // ==========================================================================
+  // Kavacha (patch 0054): step-through replay for time travel.
+  //
+  // Patch 0020 shipped restore-as-branch and deferred replay. The list answers
+  // "when were the moments"; replay answers "what was I looking at THEN",
+  // which is the question the feature exists for and the one a column of
+  // timestamps and tab counts cannot answer. Walking a step is READ-ONLY — it
+  // reads one snapshot's payload and shows its tabs. Nothing is restored until
+  // Restore is pressed, and restore stays non-destructive: it forks a branch
+  // exactly as the list does, so the present is never overwritten.
+  // ==========================================================================
+  #kavachaTimelineSnapshots = [];
+  #kavachaReplayIndex = -1;
+
+  /** Which snapshot replay is showing, in listSnapshots' newest-first order. */
+  get kavachaReplayIndex() {
+    return this.#kavachaReplayIndex;
+  }
+
+  kavachaExitReplay() {
+    this.#kavachaReplayIndex = -1;
+    document.getElementById("kavacha-timeline-replay-view").hidden = true;
+    document.getElementById("kavacha-timeline-list").hidden = false;
+    document.getElementById("kavacha-timeline-replay").hidden =
+      this.#kavachaTimelineSnapshots.length < 2;
+  }
+
+  async kavachaEnterReplay() {
+    if (this.#kavachaTimelineSnapshots.length < 2) {
+      return;
+    }
+    document.getElementById("kavacha-timeline-list").hidden = true;
+    document.getElementById("kavacha-timeline-replay").hidden = true;
+    document.getElementById("kavacha-timeline-replay-view").hidden = false;
+    // Snapshots arrive newest-first; replay starts at the OLDEST so that
+    // stepping forward runs the way the work actually happened.
+    await this.kavachaReplayStep(this.#kavachaTimelineSnapshots.length - 1);
+  }
+
+  /** Show snapshot `index` (newest-first indexing, matching listSnapshots). */
+  async kavachaReplayStep(index) {
+    const snapshots = this.#kavachaTimelineSnapshots;
+    if (!snapshots.length) {
+      return;
+    }
+    const clamped = Math.min(Math.max(index, 0), snapshots.length - 1);
+    this.#kavachaReplayIndex = clamped;
+
+    // Oldest is step 1, so "3 of 7" reads forwards even though the array is
+    // newest-first.
+    document.l10n.setAttributes(
+      document.getElementById("kavacha-timeline-step"),
+      "kavacha-timeline-step",
+      { step: snapshots.length - clamped, total: snapshots.length }
+    );
+    document.getElementById("kavacha-timeline-prev").disabled =
+      clamped >= snapshots.length - 1;
+    document.getElementById("kavacha-timeline-next").disabled = clamped <= 0;
+
+    const list = document.getElementById("kavacha-timeline-step-tabs");
+    list.textContent = "";
+    const { KavachaSpaceHistory } = ChromeUtils.importESModule(
+      "resource:///modules/KavachaSpaceHistory.sys.mjs"
+    );
+    let snapshot = null;
+    try {
+      snapshot = await KavachaSpaceHistory.getSnapshot(snapshots[clamped].id);
+    } catch (e) {
+      console.error("kavachaReplayStep: could not read snapshot", e);
+    }
+    if (this.#kavachaReplayIndex !== clamped) {
+      return; // a faster click superseded this step
+    }
+    for (const tab of snapshot?.payload?.tabs || []) {
+      const row = document.createXULElement("label");
+      row.setAttribute("crop", "end");
+      row.style.opacity = tab.pinned ? "1" : "0.85";
+      row.value = this.#kavachaPrettyUrl(tab.url);
+      if (tab.pinned) {
+        row.style.fontWeight = "600";
+      }
+      row.setAttribute("tooltiptext", tab.url || "");
+      list.append(row);
+    }
+  }
+
+  #kavachaPrettyUrl(url) {
+    try {
+      const u = new URL(url);
+      return u.host + (u.pathname === "/" ? "" : u.pathname);
+    } catch (e) {
+      return url || "";
+    }
+  }
+
+  async kavachaRestoreReplayStep() {
+    const snapshot = this.#kavachaTimelineSnapshots[this.#kavachaReplayIndex];
+    if (!snapshot) {
+      return;
+    }
+    document.getElementById("kavacha-timeline-panel").hidePopup();
+    await this.kavachaBranchSpace(snapshot.id);
+  }
+
+  // ==========================================================================
+  // Kavacha (patch 0054): compare a branch with the Space it came from, and
+  // discard it.
+  //
+  // Branching is cheap by design, which is exactly why a pile of branches
+  // becomes unreadable: the two questions 0020 left open were "what is
+  // actually different here" and "how do I get rid of the ones that led
+  // nowhere". Compare is read-only and works on the LIVE tabs of both Spaces,
+  // not the branch-point snapshot — the useful comparison is with the parent
+  // as it is NOW, since that is what the branch is an alternative to. Discard
+  // is the only destructive action here and it confirms, naming the Space.
+  // ==========================================================================
+  #kavachaTabUrls(workspaceUuid) {
+    const out = new Map();
+    for (const tab of gBrowser.tabs) {
+      if (
+        tab.getAttribute("zen-workspace-id") !== workspaceUuid ||
+        tab.hasAttribute("zen-empty-tab") ||
+        tab.closing
+      ) {
+        continue;
+      }
+      const url = tab.linkedBrowser?.currentURI?.spec || "";
+      if (!url || url === "about:blank") {
+        continue;
+      }
+      if (!out.has(url)) {
+        out.set(url, tab.label || this.#kavachaPrettyUrl(url));
+      }
+    }
+    return out;
+  }
+
+  async kavachaCompareWithParent(workspaceId = null) {
+    if (this.privateWindowOrDisabled) {
+      return;
+    }
+    const branch = workspaceId
+      ? this.getWorkspaceFromId(workspaceId)
+      : this.getActiveWorkspaceFromCache();
+    const parent = branch?.parentSpaceId
+      ? this.getWorkspaceFromId(branch.parentSpaceId)
+      : null;
+    if (!branch || !parent) {
+      return;
+    }
+
+    const mine = this.#kavachaTabUrls(branch.uuid);
+    const theirs = this.#kavachaTabUrls(parent.uuid);
+    const onlyMine = [...mine].filter(([url]) => !theirs.has(url));
+    const onlyTheirs = [...theirs].filter(([url]) => !mine.has(url));
+    const shared = [...mine].filter(([url]) => theirs.has(url));
+
+    const panel = document.getElementById("kavacha-compare-panel");
+    document.l10n.setAttributes(
+      document.getElementById("kavacha-compare-title"),
+      "kavacha-compare-title",
+      { branch: branch.name || "", parent: parent.name || "" }
+    );
+    panel.setAttribute("data-workspace-id", branch.uuid);
+
+    const body = document.getElementById("kavacha-compare-body");
+    body.textContent = "";
+    const sections = [
+      ["kavacha-compare-only-branch", onlyMine, { name: branch.name || "" }],
+      ["kavacha-compare-only-parent", onlyTheirs, { name: parent.name || "" }],
+      ["kavacha-compare-shared", shared, { name: "" }],
+    ];
+    for (const [headerId, entries, args] of sections) {
+      const header = document.createXULElement("label");
+      header.style.fontWeight = "600";
+      header.style.opacity = "0.8";
+      document.l10n.setAttributes(header, headerId, {
+        ...args,
+        count: entries.length,
+      });
+      body.append(header);
+      if (!entries.length) {
+        const none = document.createXULElement("label");
+        none.style.opacity = "0.6";
+        document.l10n.setAttributes(none, "kavacha-compare-none");
+        body.append(none);
+        continue;
+      }
+      for (const [url, title] of entries) {
+        const row = document.createXULElement("label");
+        row.setAttribute("crop", "end");
+        row.style.opacity = "0.85";
+        row.value = title || this.#kavachaPrettyUrl(url);
+        row.setAttribute("tooltiptext", url);
+        body.append(row);
+      }
+    }
+
+    const anchor = this.workspaceIcons || gURLBar.textbox;
+    panel.openPopup(anchor, "after_start", 0, 0, false, false);
+  }
+
+  async kavachaDiscardBranch(workspaceId) {
+    const branch = this.getWorkspaceFromId(workspaceId);
+    // Only a branch may be discarded through this path. A Space with no parent
+    // is somebody's actual work and has its own Delete Space item with its own
+    // confirmation; this must never become a second, softer-sounding way to
+    // delete one.
+    if (!branch?.parentSpaceId) {
+      return;
+    }
+    const [title, accept] = await document.l10n.formatValues([
+      { id: "kavacha-compare-discard-title" },
+      { id: "kavacha-compare-discard-accept" },
+    ]);
+    const body = await document.l10n.formatValue(
+      "kavacha-compare-discard-body",
+      { name: branch.name || "" }
+    );
+    const flags =
+      Services.prompt.BUTTON_TITLE_IS_STRING * Services.prompt.BUTTON_POS_0 +
+      Services.prompt.BUTTON_TITLE_CANCEL * Services.prompt.BUTTON_POS_1;
+    if (
+      Services.prompt.confirmEx(
+        window,
+        title,
+        body,
+        flags,
+        accept,
+        null,
+        null,
+        null,
+        {}
+      ) !== 0
+    ) {
+      return;
+    }
+    if (this.isWorkspaceActive(branch)) {
+      const parent = this.getWorkspaceFromId(branch.parentSpaceId);
+      if (parent) {
+        await this.changeWorkspace(parent);
+      }
+    }
+    await this.removeWorkspace(branch.uuid);
+  }
+
+  /**
+   * How many branch hops this Space is from a root. 0 for an ordinary Space.
+   * Walks parentSpaceId with a visited set: a corrupted or hand-edited session
+   * file could contain a cycle, and this runs on every strip render.
+   */
+  kavachaBranchDepth(workspace) {
+    let depth = 0;
+    let current = workspace;
+    const seen = new Set();
+    while (current?.parentSpaceId && !seen.has(current.uuid)) {
+      seen.add(current.uuid);
+      current = this.getWorkspaceFromId(current.parentSpaceId);
+      if (!current) {
+        break;
+      }
+      depth++;
+    }
+    return depth;
+  }
