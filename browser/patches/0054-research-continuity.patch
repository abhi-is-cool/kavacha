@@ -0,0 +1,57 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* ==========================================================================
+   Kavacha branch lineage in the Space strip (patch 0054).
+
+   Patch 0020 wrote parentSpaceId onto branched Spaces and nothing ever read
+   it, so a branch looked exactly like an ordinary Space in the switcher.
+   ZenSpaceIcons now stamps kavacha-branch-depth (1..3, clamped) and this is
+   the only thing that renders it.
+
+   Deliberately a MARKER, not an indent: the strip is a fixed-size row (or
+   column) of equal buttons, and indenting one would break its alignment in
+   both orientations. A short bar on the leading edge, one step dimmer per
+   level, reads as "this hangs off the one before it" without moving anything.
+   ========================================================================== */
+
+#zen-workspaces-button toolbarbutton[kavacha-branch-depth] {
+  position: relative;
+}
+
+#zen-workspaces-button toolbarbutton[kavacha-branch-depth]::before {
+  content: "";
+  position: absolute;
+  inset-inline-start: 1px;
+  inset-block: 30%;
+  width: 2px;
+  border-radius: 1px;
+  background: currentColor;
+  opacity: 0.55;
+  pointer-events: none;
+}
+
+#zen-workspaces-button toolbarbutton[kavacha-branch-depth="2"]::before {
+  opacity: 0.4;
+}
+
+#zen-workspaces-button toolbarbutton[kavacha-branch-depth="3"]::before {
+  opacity: 0.28;
+}
+
+/* Horizontal tabs (Kavacha's shipped default, patch 0010) lay the strip out as
+   a row, so the lineage marker belongs under the button rather than beside it.
+   Gated the way every other Kavacha layer gates on orientation -- the pref,
+   not a root attribute, because tabStyle flows through `zen.tabs.vertical`
+   (see kavacha-layout.inc.css). */
+/* stylelint-disable-next-line media-query-no-invalid */
+@media not -moz-pref("zen.tabs.vertical") {
+  #zen-workspaces-button toolbarbutton[kavacha-branch-depth]::before {
+    inset-inline: 30%;
+    inset-block-start: auto;
+    inset-block-end: 1px;
+    width: auto;
+    height: 2px;
+  }
+}
