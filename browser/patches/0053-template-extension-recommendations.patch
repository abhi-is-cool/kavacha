+
+  // ==========================================================================
+  // Kavacha (patch 0053): recommended extensions for a template Space.
+  // Patch 0006 deferred this with "Extensions stay at 'all' until the
+  // marketplace can install recommended sets" — but the marketplace installs
+  // Kavacha COMPONENTS (themes, layouts, bundles; ADR 0010), not
+  // WebExtensions, so it was never going to be the installer. The right
+  // installer already exists and is Firefox's: this panel recommends, and
+  // "Get extension" opens the addons.mozilla.org listing in a tab so the
+  // install runs through AMO's and Firefox's own permission prompts.
+  //
+  // Nothing is installed automatically, silently, or as a side effect of
+  // creating a Space. Recommending an extension is an endorsement and
+  // installing one on someone's behalf is not ours to do.
+  // ==========================================================================
+  #templateFor(workspace) {
+    return workspace?.template
+      ? KAVACHA_SPACE_TEMPLATES.find(t => t.id === workspace.template)
+      : null;
+  }
+
+  /** True when this Space came from a template that recommends extensions. */
+  kavachaHasRecommendations(workspaceId = null) {
+    const workspace = workspaceId
+      ? this.getWorkspaceFromId(workspaceId)
+      : this.getActiveWorkspaceFromCache();
+    return !!this.#templateFor(workspace)?.recommendedExtensions?.length;
+  }
+
+  async kavachaShowRecommendedExtensions(workspaceId = null) {
+    if (this.privateWindowOrDisabled) {
+      return;
+    }
+    const workspace = workspaceId
+      ? this.getWorkspaceFromId(workspaceId)
+      : this.getActiveWorkspaceFromCache();
+    const template = this.#templateFor(workspace);
+    const recommendations = template?.recommendedExtensions;
+    if (!workspace || !recommendations?.length) {
+      return;
+    }
+
+    // Which are already present? getAddonsByIDs resolves null per unknown id.
+    let installed = [];
+    try {
+      installed = await lazy.AddonManager.getAddonsByIDs(
+        recommendations.map(r => r.id)
+      );
+    } catch (e) {
+      console.error("gZenWorkspaces: could not query installed addons", e);
+      installed = recommendations.map(() => null);
+    }
+
+    const panel = document.getElementById("kavacha-recommendations-panel");
+    document.l10n.setAttributes(
+      document.getElementById("kavacha-recommendations-title"),
+      "kavacha-recommendations-title",
+      { name: workspace.name || "" }
     );
+    panel.setAttribute("data-workspace-id", workspace.uuid);
+
+    const list = document.getElementById("kavacha-recommendations-list");
+    list.textContent = "";
+    const [getLabel, haveLabel] = await document.l10n.formatValues([
+      { id: "kavacha-recommendations-get" },
+      { id: "kavacha-recommendations-installed" },
+    ]);
+
+    let anyInstalled = false;
+    recommendations.forEach((rec, i) => {
+      const present = !!installed[i];
+      anyInstalled ||= present;
+
+      const row = document.createXULElement("hbox");
+      row.setAttribute("align", "start");
+      row.style.gap = "10px";
+
+      const copy = document.createXULElement("vbox");
+      copy.setAttribute("flex", "1");
+      const name = document.createXULElement("label");
+      name.style.fontWeight = "600";
+      name.value = rec.name;
+      const why = document.createXULElement("description");
+      why.style.opacity = "0.75";
+      why.textContent = rec.why;
+      copy.append(name, why);
+
+      const action = document.createXULElement("button");
+      if (present) {
+        action.setAttribute("label", haveLabel);
+        action.setAttribute("disabled", "true");
+      } else {
+        action.setAttribute("label", getLabel);
+        action.addEventListener("command", () => {
+          panel.hidePopup();
+          // The AMO listing, not a direct .xpi: the install must go through
+          // Firefox's permission prompt, and the user should see the
+          // reviews, permissions and source before deciding.
+          window.openTrustedLinkIn(KAVACHA_AMO + rec.slug + "/", "tab");
+        });
+      }
+
+      row.append(copy, action);
+      list.append(row);
+    });
+
+    // "Use only these here" writes the per-Space allowlist (patch 0004) from
+    // the recommendations that are actually installed. Meaningless — and so
+    // disabled — until at least one of them is.
+    // The button's listener is bound once in addPopupListeners and reads the
+    // Space back off the panel, so repeated opens cannot stack handlers.
+    const limit = document.getElementById("kavacha-recommendations-limit");
+    limit.disabled = !anyInstalled;
+
+    const anchor = this.workspaceIcons || gURLBar.textbox;
+    panel.openPopup(anchor, "after_start", 0, 0, false, false);
   }
 
+  async kavachaLimitSpaceToRecommended(workspaceId) {
+    const workspace = this.getWorkspaceFromId(workspaceId);
+    const recommendations =
+      this.#templateFor(workspace)?.recommendedExtensions || [];
+    if (!workspace || !recommendations.length) {
+      return;
+    }
+    let installed = [];
+    try {
+      installed = await lazy.AddonManager.getAddonsByIDs(
+        recommendations.map(r => r.id)
+      );
+    } catch (e) {
+      console.error("gZenWorkspaces: could not query installed addons", e);
+      return;
+    }
+    const ids = installed.filter(Boolean).map(a => a.id);
+    if (!ids.length) {
+      return;
+    }
+    workspace.extensions = ids;
+    this.saveWorkspace(workspace);
+    if (this.isWorkspaceActive(workspace)) {
+      await this.applyWorkspaceExtensions(workspace);
+    }
+  }
