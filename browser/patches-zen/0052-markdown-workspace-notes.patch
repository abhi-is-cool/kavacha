+  }
+
+  // ==========================================================================
+  // Kavacha (patch 0052): markdown preview for workspace notes.
+  //
+  // The textarea stays the single source of truth — it is what autosaves, and
+  // the preview is a sibling shown in its place, never an editable rendering.
+  // There is therefore no DOM-back-to-markdown round trip that could quietly
+  // rewrite what the user typed.
+  //
+  // Rendering goes through KavachaMarkdown, which builds nodes rather than
+  // parsing HTML. That matters here specifically: this panel is chrome, so
+  // innerHTML on note text would be script execution with system privileges.
+  // ==========================================================================
+  kavachaSetNotesPreview(on) {
+    const textarea = document.getElementById("kavacha-notes-textarea");
+    const preview = document.getElementById("kavacha-notes-preview");
+    const toggle = document.getElementById("kavacha-notes-preview-toggle");
+    if (!textarea || !preview) {
+      return;
+    }
+    toggle.checked = !!on;
+    textarea.hidden = !!on;
+    preview.hidden = !on;
+    if (!on) {
+      // Drop the rendered nodes rather than leaving a stale copy of the note
+      // hidden in the DOM.
+      preview.textContent = "";
+      textarea.focus();
+      return;
+    }
+    preview.textContent = "";
+    document.l10n
+      .formatValue("kavacha-notes-preview-empty")
+      .then(label => preview.setAttribute("data-empty-label", label))
+      .catch(() => {});
+    try {
+      const { KavachaMarkdown } = ChromeUtils.importESModule(
+        "resource:///modules/KavachaMarkdown.sys.mjs"
+      );
+      preview.appendChild(KavachaMarkdown.render(textarea.value, document));
+    } catch (e) {
+      console.error("gZenWorkspaces: could not render note preview", e);
+      // Fall back to the raw text rather than an empty box — the note is the
+      // user's data and must never appear to have been lost.
+      preview.appendChild(document.createTextNode(textarea.value));
+    }
   }
 
   #flushWorkspaceNotes() {
