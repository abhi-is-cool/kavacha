   --studio-text: var(--kavacha-text-primary, #edeaf7);
   --studio-text-dim: var(--kavacha-text-secondary, #a79fc4);
-  --studio-accent: var(--zen-primary-color, var(--kavacha-accent, #8b7bd8));
+  /* Canonical definition and rationale: kavacha-midnight.inc.css. Repeated
+     here because this is a content document -- the chrome token floor is not
+     in its cascade -- not because the value is local. */
+  --kavacha-accent-fallback: #8b7bd8;
+  --studio-accent: var(
+    --zen-primary-color,
+    var(--kavacha-accent, var(--kavacha-accent-fallback))
+  );
   color-scheme: dark;
 }
 
